# ── 构建产物 ─────────────────────────────────────────────
/Mergence.exe
*.exe
*.exe~
*.syso
!/src/appres.syso

# ── Python / 测试运行期缓存 ──────────────────────────────
__pycache__/
*.pyc
*.pid

# 测试写出的临时配置文件（可能带真实 access_key，别提交）
*.tmp

# test 跑测试时产生的隔离数据目录（Edge/WebView2 缓存、隔离 HOME、截图）
test/home/
test/gui_home/
test/ui_home/
test/claim_home/
test/shots/
test/zcacc_home/
test/zcnative_home/

# ── 本机运行期目录（随机器变化，不进版本库）────────────────
# config/ 放用户配置（含真实 access_key 与上游密钥）；
# data/   放日志、用量、WebView2 缓存、托管实例数据。
# 两者都由程序启动时自动创建，缺了也能跑。
config/
data/

# ── 本机数据快照（内含真实账号 token 与计费数据）与历史快照 ──
# 三者已移出仓库、只存在于仓库之外；规则保留作兜底：
# 万一又被放回仓库内，不至于被误提交。
_ref/
backups/
_backup/

# ── 编辑器 / 系统 ───────────────────────────────────────
.idea/
.vscode/
*.swp
*~
Thumbs.db
.DS_Store
